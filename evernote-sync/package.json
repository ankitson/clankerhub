{
  "name": "evernote-sync",
  "version": "1.0.0",
  "description": "Background service that maintains a continuously-updated local directory of markdown files mirroring an Evernote account",
  "main": "src/index.js",
  "bin": {
    "evernote-sync": "./src/index.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "daemon": "node src/index.js --daemon",
    "sync": "node src/index.js --sync",
    "full": "node src/index.js --full",
    "test": "node --test test/*.test.js"
  },
  "keywords": ["evernote", "markdown", "sync", "mirror"],
  "license": "MIT",
  "dependencies": {
    "thrift": "^0.22.0",
    "turndown": "^7.2.0",
    "dotenv": "^16.4.0"
  }
}
